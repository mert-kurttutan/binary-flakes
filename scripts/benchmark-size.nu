#!/usr/bin/env nu

use lib/common.nu [current-version ensure-repository-root require-command]
use lib/packages.nu [package-config tar-sources binary-sources deb-sources]

const PACKAGES = [obsidian zed proton-pass-cli proton-pass]

def sources-for [package: string, version: string] {
  let _input = $in
  match $package {
    "proton-pass-cli" => (do { binary-sources $package $version })
    "proton-pass" => (do { deb-sources $package $version })
    _ => (do { tar-sources $package $version })
  }
}

def file-size [path: path] {
  (^stat --format %s $path | str trim | into int)
}

def download [url: string, destination: path] {
  let result = (^curl --fail --location --retry 3 --retry-all-errors --show-error --silent $url --output $destination | complete)
  if $result.exit_code != 0 { error make ($result.stderr | str trim) }
}

def format-size [bytes: int] {
  $bytes | into filesize
}

def benchmark-package [package: string, version: string, output_dir: path, work_dir: path] {
  let source_items = (sources-for $package $version)
  let missing = ($source_items | where {|item| not ($"($output_dir)/($item.asset)" | path exists) })
  if not ($missing | is-empty) {
    print $"Repacking missing assets for ($package) version ($version)..."
    let result = (^nu scripts/repack-release.nu $package --version $version --output-dir $output_dir | complete)
    if $result.exit_code != 0 { error make ($result.stderr | str trim) }
  }
  mut rows = []
  for item in $source_items {
    let original = $"($work_dir)/($item.source)"
    let produced = $"($output_dir)/($item.asset)"
    if not ($produced | path exists) {
      error make $"Missing produced asset: ($produced). Run the repack script first."
    }
    download $item.url $original
    let original_size = file-size $original
    let produced_size = file-size $produced
    let saved = $original_size - $produced_size
    let row = {
      package: $package
      version: $version
      asset: $item.asset
      original_bytes: $original_size
      produced_bytes: $produced_size
      saved_bytes: $saved
      reduction_percent: (($saved * 100.0) / $original_size | math round -p 2)
    }
    $rows = ($rows ++ [$row])
  }
  $rows
}

def main [
  --package: string = "all"
  --version: string = ""
  --asset-dir: string = ".release-assets"
  --output: string = "docs/binary-size-reduction-results.md"
] {
  ensure-repository-root
  require-command curl
  require-command stat
  require-command mktemp
  require-command nu

  let selected = if $package == "all" { $PACKAGES } else { [$package] }
  if $package == "all" and $version != "" {
    error make "--version can only be used with a single --package"
  }
  for item in $selected {
    if $item not-in $PACKAGES { error make $"Unsupported benchmark package: ($item)" }
  }

  let output_dir = ($asset_dir | path expand)
  let report = ($output | path expand)
  let work_dir = (mktemp --directory | str trim)
  mut results = []
  try {
    for item in $selected {
      let config = (package-config $item)
      let version = if $version == "" { current-version $config.file } else { $version }
      $results = ($results ++ (benchmark-package $item $version $output_dir $work_dir))
    }

    let summary = ($results
      | group-by package
      | transpose package rows
      | each {|group|
        let original = ($group.rows | get original_bytes | math sum)
        let produced = ($group.rows | get produced_bytes | math sum)
        let saved = $original - $produced
        {
          package: $group.package
          version: ($group.rows | get version | first)
          original: (format-size $original)
          produced: (format-size $produced)
          saved: (format-size $saved)
          reduction: $"(($saved * 100.0) / $original | math round -p 2)%"
        }
      })
    let report_rows = ($summary | each {|row|
      $"| `($row.package)` | `($row.version)` | ($row.original) | ($row.produced) | ($row.saved) | ($row.reduction) |"
    })
    let original_total = ($results | get original_bytes | math sum)
    let produced_total = ($results | get produced_bytes | math sum)
    let saved_total = $original_total - $produced_total
    let total_reduction = (($saved_total * 100.0) / $original_total | math round -p 2)
    let markdown = ([
      "# Binary size reduction benchmark"
      ""
      "Generated by `scripts/benchmark-size.nu`. Codex is excluded because its upstream files are already zstd-compressed."
      ""
      "| Package | Version | Original | Produced | Saved | Reduction |"
      "| --- | --- | ---: | ---: | ---: | ---: |"
      ...$report_rows
      ""
      $"**Total:** (format-size $original_total) → (format-size $produced_total), saving (format-size $saved_total) (($total_reduction)%)"
      ""
    ] | str join "\n")
    $markdown | save --force $report

    print "Binary size reduction by package:"
    $summary | table
    print $"Wrote Markdown report: ($report)"
    print ""
    print $"Total upstream size: (format-size $original_total)"
    print $"Total produced size:  (format-size $produced_total)"
    print $"Total reduction:      (format-size $saved_total) (($total_reduction)%)"
  } finally {
    rm --recursive --force $work_dir
  }
}
